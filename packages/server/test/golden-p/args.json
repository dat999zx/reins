{
  "configModelAndEffort": {
    "args": [
      "-p",
      "--input-format",
      "stream-json",
      "--output-format",
      "stream-json",
      "--verbose",
      "--session-id",
      "<UUID>",
      "--permission-mode",
      "acceptEdits",
      "--permission-prompt-tool",
      "mcp__reins__approve",
      "--mcp-config",
      "<TMP>/mcp.json",
      "--settings",
      "<TMP>/settings.json",
      "--append-system-prompt-file",
      "<TMP>/reins-card-note.md",
      "--model",
      "claude-haiku-5-5",
      "--effort",
      "low",
      "--thinking-display",
      "summarized"
    ],
    "hooks": {
      "PostToolUse": [
        {
          "hooks": [
            {
              "timeout": 30,
              "type": "http",
              "url": "<HOOK_URL>"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "hooks": [
            {
              "timeout": 30,
              "type": "http",
              "url": "<HOOK_URL>"
            }
          ],
          "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell"
        }
      ]
    }
  },
